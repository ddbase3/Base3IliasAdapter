general_ecosystem_modular_label#:#Modular e extensível
general_ecosystem_modular_text#:#Os plugins BASE3 acrescentam funcionalidades de forma limpa sem alterações ao core.
general_ecosystem_architecture_label#:#Arquitetura pouco acoplada
